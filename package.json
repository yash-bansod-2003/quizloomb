{
   "name": "quizloom",
   "version": "1.0.0",
   "main": "index.js",
   "type": "module",
   "scripts": {
      "dev": "nodemon",
      "start": "cross-env NODE_ENV=production node ./dist/src/index.js",
      "build": "rimraf dist && swc ./src --config-file ./.swcrc --out-dir dist --ignore **/*.test.ts",
      "lint": "eslint ./src",
      "format": "prettier ./src --write",
      "prepare": "husky",
      "typeorm": "typeorm-ts-node-esm",
      "migration:generate": "cross-env NODE_ENV=development npx typeorm-ts-node-esm migration:generate -d ./dist/src/data-source.js ./src/migrations -t",
      "migration:dev": "cross-env NODE_ENV=production typeorm-ts-node-esm migration:run -d ./dist/src/data-source.js",
      "migration:run": "cross-env NODE_ENV=production typeorm-ts-node-esm migration:run -d ./src/data-source.js"
   },
   "keywords": [
      "quiz"
   ],
   "author": "Yash Gajanan Bansod",
   "license": "MIT",
   "description": "",
   "devDependencies": {
      "@commitlint/cli": "^20.1.0",
      "@commitlint/config-conventional": "^20.0.0",
      "@swc/cli": "^0.7.9",
      "@swc/core": "^1.15.3",
      "@types/bcrypt": "^6.0.0",
      "@types/cookie-parser": "^1.4.10",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.5",
      "@types/http-errors": "^2.0.5",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/morgan": "^1.9.10",
      "@types/multer": "^2.0.0",
      "@types/node": "^24.10.1",
      "@types/nodemailer": "^7.0.4",
      "@types/pg": "^8.15.6",
      "eslint": "^9.39.1",
      "husky": "^9.1.7",
      "lint-staged": "^16.2.7",
      "nodemon": "^3.1.11",
      "prettier": "3.6.2",
      "rimraf": "^6.1.2",
      "tsconfig-paths": "^4.2.0",
      "tsx": "^4.20.6",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.47.0"
   },
   "dependencies": {
      "@eslint/js": "^9.39.1",
      "@google/generative-ai": "^0.24.1",
      "bcrypt": "^6.0.0",
      "better-auth": "^1.4.1",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "cross-env": "^10.1.0",
      "dotenv": "^17.2.3",
      "express": "^5.1.0",
      "helmet": "^8.1.0",
      "http-errors": "^2.0.1",
      "jsonwebtoken": "^9.0.2",
      "mailgen": "^2.0.32",
      "morgan": "^1.10.1",
      "multer": "^2.0.2",
      "nodemailer": "^7.0.10",
      "pg": "^8.16.3",
      "reflect-metadata": "^0.2.2",
      "ts-node": "^10.9.2",
      "typeorm": "0.3.27",
      "uuid": "^13.0.0",
      "winston": "^3.18.3",
      "zod": "^4.1.12"
   }
}